{
  "name": "rpg-maker-mv-cheat-menu-plugin",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "build": "pnpm typecheck && eslint . && vitest run && vite build",
    "build:release": "pnpm build && node scripts/build-release.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.10.0"
}
